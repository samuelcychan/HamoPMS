##
## HamoPMS — Production Environment
## All secrets MUST be injected via CI/CD or a secrets manager (e.g. AWS Secrets Manager).
## Do NOT commit real values to source control.
##
APP_NAME=HamoPMS
APP_ENV=production
APP_KEY=      # injected by CI/CD
APP_DEBUG=false
APP_URL=https://api.hamopms.com
APP_TIMEZONE=UTC
APP_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily,stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=      # set via secret
DB_PORT=5432
DB_DATABASE=hamo_pms
DB_USERNAME=  # set via secret
DB_PASSWORD=  # set via secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=   # set via secret
REDIS_PASSWORD= # set via secret
REDIS_PORT=6379

QUEUE_CONNECTION=redis

BROADCAST_CONNECTION=redis
FILESYSTEM_DISK=s3

MAIL_MAILER=smtp
MAIL_HOST=    # set via secret
MAIL_PORT=587
MAIL_USERNAME= # set via secret
MAIL_PASSWORD= # set via secret
MAIL_FROM_ADDRESS="no-reply@hamopms.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=    # set via secret
AWS_SECRET_ACCESS_KEY= # set via secret
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=hamo-pms-production

SANCTUM_STATEFUL_DOMAINS=api.hamopms.com
