##
## HamoPMS — Development Environment
## Copy to .env for local development: cp .env.dev .env
##
APP_NAME=HamoPMS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
APP_LOCALE=en

AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_DECAY_SECONDS=900

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# SQLite for quick local setup; switch to mysql/pgsql if preferred
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=hamo_pms_dev
# DB_USERNAME=root
# DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database

QUEUE_CONNECTION=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
